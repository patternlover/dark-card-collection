# Medusa backend — Dark Card Collection
# Copia questo file in `.env` e adatta i valori (il `.env` è gitignored).

# Database (PostgreSQL) + Redis
# Dev locale: servizi in WSL Ubuntu (`service postgresql start; service redis-server start`)
# oppure `docker compose -f docker-compose.yml up -d`.
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_dev
REDIS_URL=redis://localhost:6379

# Secrets — genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-64-hex-jwt-secret
COOKIE_SECRET=your-64-hex-cookie-secret
# 32 bytes hex (64 caratteri) — cifratura MFA Admin
AUTH_MFA_ENCRYPTION_KEY=your-64-hex-mfa-encryption-key

# CORS — storefront (Next.js) + Admin
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:9000,http://localhost:3000

# Stripe — il provider payment-stripe viene registrato SOLO se STRIPE_SECRET_KEY è presente.
# Richiesto dal checkout a partire da F2.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Richiesti dalle fasi successive (F2/F3) ---
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...    (creata dal seed; vedi Admin → Settings → API keys)
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# RESEND_API_KEY=re_...                        (email conferma ordine)
# EMAIL_FROM=noreply@darkcardcollection.com
# GOOGLE_DRIVE_FOLDER_ID=...                   (upload scontrini lotti, modulo procurement F1)