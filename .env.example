# Storefront — Dark Card Collection (Next.js)
# Le variabili del backend Medusa sono in apps/backend/.env.example (vedi docs/project/medusa/DEPLOYMENT.md).

# Medusa backend (headless commerce engine)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable key da Medusa Admin → Settings → API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Sito
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (checkout Payment Element — PAUSATO)
# PRODUZIONE: chiavi live dal Dashboard Stripe. Deve appartenere allo STESSO account dello sk_test/live del backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Email (Resend) — usata dal contact form storefront
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@darkcardcollection.com

# Google Tag Manager (optional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Rimosse con Payload (2026-09-05): DATABASE_URI, PAYLOAD_SECRET, GOOGLE_* OAuth dashboard,
#     GOOGLE_DRIVE_*, DASH_SESSION_SECRET, ENABLE_DASH_SQL, BLOB_READ_WRITE_TOKEN (per upload prodotti). ---