# Database (PostgreSQL)
DATABASE_URI=postgresql://user:password@localhost:5432/dark_card_db

# Payload CMS
PAYLOAD_SECRET=your-secret-key-min-32-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
# PRODUZIONE: usa le chiavi live (sk_live_... / pk_live_...) dal Dashboard Stripe.
# Il webhook live va configurato su https://darkcardcollection.com/api/stripe/webhook
# con l'evento checkout.session.completed e il relativo whsec_live_...
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
# Richiesta dal checkout embedded (stessa chiave pubblicabile, ma deve essere NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_your_token_here

# Email (Resend) — conferma ordine via webhook Stripe
# Serve RESEND_API_KEY; senza, l'email viene loggata in console.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@darkcardcollection.com

# Dashboard session (HMAC cookie /dashboard, fallback: PAYLOAD_SECRET)
DASH_SESSION_SECRET=your-dash-session-secret-here

# Google Tag Manager (optional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google OAuth (dashboard login, whitelist email)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
DASHBOARD_GOOGLE_EMAILS=you@gmail.com,other@gmail.com

# Google Drive (upload scontrini lotti)
# Metodo consigliato (account personale): OAuth2 con refresh token.
# Creare un OAuth Client ID "Desktop app" in Google Cloud Console → Credentials,
# abilitare Google Drive API, poi generare il refresh token con:
#   pnpm exec tsx scripts/drive-auth.ts url   → autorizza col tuo account
#   pnpm exec tsx scripts/drive-auth.ts token <CODE>
GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
# GOOGLE_DRIVE_FOLDER_ID accetta sia l'ID puro sia l'URL completo
# (https://drive.google.com/drive/folders/<id>) — viene normalizzato nel codice.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Metodo alternativo (solo account Workspace): service account.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Sezione SQL dashboard (sola lettura). true = sempre attiva, false = sempre disattiva.
# Non impostata: attiva in dev, disattiva in produzione.
# In produzione: lascia non impostata o false.
ENABLE_DASH_SQL=false
